# 后续在 .env.local 填写真实密钥，不要提交或发送到聊天。
# 本机密钥开发用 developer；云端用 vertex 与服务身份，不需要 GEMINI_API_KEY。
GEMINI_PROVIDER=developer
GEMINI_API_KEY=
# 在 Google AI Studio 确认该项目可用且有免费额度的文字模型，再填写模型 ID。
# 以下模型已在 2026-11-05 的本地联调中实际调用成功；仍需核对自己项目的可用性和免费额度。
# 未配置时接口会明确提示，不会返回模拟回复。
GEMINI_MODEL=gemini-3.1-flash-lite

# 本地开发用 local；统一服务端测试使用 shared。
CHAT_ACCESS_MODE=local
# shared 模式必须填写自己的正式 HTTPS 服务根地址（无路径和查询参数）。
CHAT_PUBLIC_ORIGIN=
# shared 模式使用服务器 ADC 连接 Firestore，手机不持有云端凭据。
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
CHAT_FIRESTORE_COLLECTION=travelChatAccess
CHAT_DAILY_REQUEST_LIMIT=100
CHAT_SESSION_DAILY_REQUEST_LIMIT=20
CHAT_SESSION_HOURS=4
# 仅临时匿名测试时由负责人在服务端改为 true；关闭后也拒绝已有匿名会话。
CHAT_ALLOW_ANONYMOUS_TEST=false
# 独立于生成限额：每天最多签发 100 个匿名会话，防止重复领取无限写入。
CHAT_ANONYMOUS_SESSION_DAILY_LIMIT=100

# Google Places (New) 照片：默认关闭，先由负责人核对计费、API限制和条款。
PLACES_PHOTOS_ENABLED=false
# 仅后端填写，线上用 Secret Manager 注入；不放 EXPO_PUBLIC_*。
GOOGLE_PLACES_API_KEY=
# Places 外部请求总量（Text Search 和 Photo 各占一次，失败也计数），UTC日持久化。
PLACES_DAILY_REQUEST_LIMIT=100
PLACES_SESSION_DAILY_REQUEST_LIMIT=80
# 负责人审阅并部署本应用的公开条款/隐私路由后填写正式 HTTPS 地址。
PLACES_TERMS_URL=
PLACES_PRIVACY_URL=
